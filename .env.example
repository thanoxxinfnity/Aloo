# ---------------------------------------------------------------------------
# ALOO — optional server-side fallback keys.
# The app works WITHOUT this file: users can paste their own keys into the
# in-app Settings drawer (stored in localStorage, sent per-request).
# These env vars are only the fallback when a request arrives with no key.
# ---------------------------------------------------------------------------

# https://build.nvidia.com  -> "Get API Key"
NVIDIA_NIM_API_KEY=

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Tavily gives high-quality search results for the Deep Research
# engine. Without it, ALOO falls back to a keyless DuckDuckGo scrape.
TAVILY_API_KEY=
