    "lucide-react": "^0.454.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
